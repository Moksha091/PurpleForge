{
  "name": "PurpleForge Detection-as-Code",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/tailscale/codespace/tailscale": {
      "version": "latest"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [443, 3001, 3443, 8000, 8080, 8889, 9200, 1514, 1515, 55000],
  "portsAttributes": {
    "8080": {
      "label": "DFIR-IRIS",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-yaml",
        "humao.rest-client"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true
      }
    }
  }
}
