# PurpleForge Cloud SECOPS Stack Configuration
# Copy this file to .env and customize values for production deployment

# Tailscale Mesh Configuration
SECOPS_TAILSCALE_IP=100.64.0.10
TARGET_LAB_TAILSCALE_IP_WS01=100.64.0.20
TARGET_LAB_TAILSCALE_IP_DC01=100.64.0.21

# Wazuh Indexer & OpenSearch Credentials
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretAdmin123!
OPENSEARCH_URL=https://172.28.0.10:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=SecretAdmin123!

# Wazuh Manager API & WUI Credentials
WAZUH_API_USER=wazuh-wui
# Matches the default API user in the Wazuh Manager image. If changed, update the API user too.
WAZUH_API_PASSWORD=wazuh-wui

# Shuffle SOAR Configuration
SHUFFLE_WEBHOOK_URL=https://172.28.0.21:3001/api/v1/hooks/webhook_purpleforge_alert
SHUFFLE_API_KEY=your_shuffle_api_key_here

# Threat Intelligence Enrichment API Keys
VIRUSTOTAL_API_KEY=your_virustotal_v3_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_v2_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here

# DFIR-IRIS Case Management
IRIS_DB_USER=postgres
IRIS_DB_PASSWORD=SecretIrisDB123!
IRIS_DB_ADMIN_USER=irisadmin
IRIS_DB_ADMIN_PASSWORD=SecretIrisAdmin123!
IRIS_ADM_USERNAME=administrator
IRIS_ADM_PASSWORD=SecretIris123!
IRIS_ADM_EMAIL=administrator@localhost
IRIS_SECRET_KEY=ChangeMeSuperSecretKey998877
IRIS_SECURITY_PASSWORD_SALT=ChangeMeIrisSecuritySalt998877

# Slack / Discord Notification Webhook
SOAR_NOTIFICATION_WEBHOOK=https://discord.com/api/webhooks/your/webhook/url
